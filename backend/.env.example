# DevPilot AI - Backend Configuration

# ---- Primary Datastore: MongoDB Atlas (used when MONGODB_URI is set) ----
# Without MONGODB_URI the backend gracefully falls back to SQLite.
# DATABASE_URL=sqlite:///./devpilot.db
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB_NAME="devpilot_ai"

# ---- Vector Store: Pinecone (used when VECTOR_STORE=pinecone + PINECONE_API_KEY set) ----
# Without it, a local JSON-backed vector index is used.
VECTOR_STORE="pinecone"
PINECONE_API_KEY="your_pinecone_api_key"
PINECONE_INDEX_NAME="devpilot-vectors"

# ---- Security ----
JWT_SECRET_KEY="your_jwt_secret_key_change_in_production"

# ---- AI Core: fallback provider used when a specific provider key is missing ----
AI_API_KEY="mock_key"
AI_API_URL="https://api.openai.com/v1"

# ---- Multi-provider LLM routing (one provider per agent) ----
# Repository Analyzer -> Groq
GROQ_API_KEY=""
GROQ_BASE_URL="https://api.groq.com/openai/v1"
GROQ_MODEL="llama-3.3-70b-versatile"

# Code Review -> Gemini
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/openai/"
GEMINI_MODEL="gemini-2.0-flash"

# Documentation -> Mistral
MISTRAL_API_KEY=""
MISTRAL_BASE_URL="https://api.mistral.ai/v1"
MISTRAL_MODEL="mistral-large-latest"

# Testing -> NVIDIA
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.3-70b-instruct"

# Repository Chat -> OpenRouter
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"

# Project Health -> Cerebras
CEREBRAS_API_KEY=""
CEREBRAS_BASE_URL="https://api.cerebras.ai/v1"
CEREBRAS_MODEL="gpt-oss-120b"

# ---- GitHub OAuth (Optional) ----
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# ---- App ----
APP_NAME="DevPilot AI"
CORS_ORIGINS=["http://localhost:5173"]
LOG_LEVEL="INFO"
